# Example .env configuration for Plan Upgrade Backend
# Copy these and update with your actual Stripe credentials

# ===== STRIPE CONFIGURATION =====
# Get these from: https://dashboard.stripe.com/apikeys

# Secret key (keep this secure, never commit to git)
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOP

# Webhook signing secret (from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_test_1234567890abcdefghijklmnopqrstuvwxyz

# ===== STRIPE PRICE IDs =====
# Create these in Stripe Dashboard: https://dashboard.stripe.com/products
# Each price ID represents a subscription product

# Basic Plan: $100/month
STRIPE_PRICE_BASIC=price_1234567890abcdefg

# Pro Plan: $250/month
STRIPE_PRICE_PRO=price_0987654321fedcbah

# Enterprise Plan: $1000/month
STRIPE_PRICE_ENTERPRISE=price_abcdef1234567890i

# Optional: Setup/one-time fees (create separate prices for these)
# These are only added if the customer is upgrading from a lower tier
STRIPE_PRICE_BASIC_SETUP=price_setup_basic_001
STRIPE_PRICE_PRO_SETUP=price_setup_pro_001
STRIPE_PRICE_ENTERPRISE_SETUP=price_setup_enterprise_001

# ===== FRONTEND URLS =====
# These are used for Stripe redirect URLs

# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OR Production
# NEXT_PUBLIC_SITE_URL=https://app.openresq.com

# ===== BACKEND URLS =====
# Internal URL for backend-to-backend communication (optional)

# Local development
BACKEND_API_URL=http://localhost:8000

# OR Production
# BACKEND_API_URL=https://api.openresq.com

# ===== FIREBASE CREDENTIALS =====
# These should already be configured in your firebase_config.py
# Ensure these environment variables are set:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-key.json
# or use FIREBASE_ADMIN_SDK_KEY with base64 encoded credentials

# ===== PORT CONFIGURATION =====
# FastAPI server port
PORT=8000

# ===== ENVIRONMENT =====
APP_ENV=development
# OR for production:
# APP_ENV=production

# ===== CORS CONFIGURATION =====
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# For production, specify your domain:
# CORS_ORIGINS=https://app.openresq.com,https://www.openresq.com

# ===== LOGGING =====
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===== DATABASE =====
# If using traditional SQL database (not required if using Firestore only)
# DATABASE_URL=postgresql://user:password@localhost/openresq

# ===== STRIPE TEST MODE CREDENTIALS =====
# These are example test credentials for development
# Use these in development to test without charging real money

# Test API Keys (for development):
# Publishable Key: pk_test_51234567890abcdefghijk
# Secret Key: sk_test_51234567890abcdefghijk

# To get test stripe products and prices:
# 1. Log into Stripe Dashboard
# 2. Toggle "View test data" in top-right
# 3. Go to Products and create test prices
# 4. Copy the price IDs (price_xxx) and paste above

# ===== PAYMENT INTENT CONFIGURATION =====
# Currency for payments (3-letter code)
STRIPE_CURRENCY=usd

# ===== SUCCESS/FAILURE URLS =====
# These are set dynamically in the code, but you can override here if needed:
# STRIPE_SUCCESS_URL=https://app.openresq.com/billing?success=true
# STRIPE_FAILURE_URL=https://app.openresq.com/billing?canceled=true

# ===== NOTES =====
# - STRIPE_SECRET_KEY should be treated as a secret and never committed to git
# - Keep test credentials for development, use production keys only in production env
# - Stripe webhook secret is needed to verify webhook signatures
# - Price IDs must be updated when you create new prices in Stripe Dashboard
# - All STRIPE_PRICE_* variables should match subscriptions created in Stripe
# - Optional setup price variables (_SETUP) can be omitted if not using setup fees
#
# For more information:
# - Stripe API: https://stripe.com/docs/api
# - Stripe Pricing Table: https://stripe.com/docs/billing/subscriptions
# - Environment Setup: See UPGRADE_PLAN_BACKEND.md
